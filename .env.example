# Platform-injected on deploy. Copy to .env locally if needed — never commit secrets.
# DATABASE_URL=
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# GROK_PREVIEW_CLIENT_SECRET=
# XAI_API_KEY=
# STRIPE_WEBHOOK_SECRET=   whsec_... from the Stripe Dashboard's webhook
#                          endpoint config (src/routes/api/webhooks/stripe.ts).
#                          Required at runtime -- the endpoint fails closed
#                          (500) without it rather than accepting unverified
#                          deliveries.
# STRIPE_SECRET_KEY=       sk_... Not read anywhere in this app today (plan
#                          is inferred from checkout.session.completed's own
#                          amount_total, no Stripe API call needed) -- kept
#                          separate from STRIPE_WEBHOOK_SECRET on purpose so
#                          the two are never confused, and reserved here for
#                          whenever this app does need to call the Stripe API
#                          directly.
